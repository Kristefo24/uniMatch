# ---- Which storage backend to use -----------------------------------------
# json     → local file (server/data/store.json)  [default, zero setup]
# mysql    → local XAMPP / MySQL
# supabase → hosted Postgres
DB_DRIVER=json

# Server
PORT=4000
JWT_SECRET=change-me-in-production

# ---- Email (Brevo HTTP API, for signup/reset OTPs + staff-confirm notice) --
# Leave both blank to fall back to logging emails to the console instead of
# sending them -- useful for local dev/testing without real credentials.
# Sent over HTTPS (not SMTP) since raw SMTP is blocked outbound on Railway.
# GMAIL_USER: the verified "from" address (e.g. unimatch2026@gmail.com) --
# verify it once at app.brevo.com under Senders (no domain/DNS needed, just
# click the confirmation link Brevo emails to that address). The name is a
# holdover from when this used Gmail SMTP directly.
# BREVO_API_KEY: an API key from app.brevo.com under SMTP & API → API Keys.
GMAIL_USER=
BREVO_API_KEY=

# ---- MySQL (XAMPP) ---------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=unimatch

# ---- Supabase (Postgres) ---------------------------------------------------
# Use the connection string from Project Settings → Database
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
# Optional (only if you use the supabase-js client features)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
