# ---- Which storage backend to use -----------------------------------------
# json     → local file (server/data/store.json)  [default, zero setup]
# mysql    → local XAMPP / MySQL
# supabase → hosted Postgres
DB_DRIVER=json

# Server
PORT=4000
JWT_SECRET=change-me-in-production

# ---- Email (Gmail SMTP, for signup/reset OTPs + staff-confirm notice) -----
# Leave both blank to fall back to logging emails to the console instead of
# sending them -- useful for local dev/testing without real credentials.
# GMAIL_USER: the sending Gmail address (e.g. unimatch2026@gmail.com).
# GMAIL_APP_PASSWORD: a 16-character App Password from that Google account's
# Security settings (requires 2-Step Verification to be turned on) -- NOT
# the account's normal login password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# ---- MySQL (XAMPP) ---------------------------------------------------------
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=unimatch

# ---- Supabase (Postgres) ---------------------------------------------------
# Use the connection string from Project Settings → Database
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres
# Optional (only if you use the supabase-js client features)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
